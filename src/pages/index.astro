---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    name: 'voice-flow',
    href: 'https://github.com/whybepb/voice-flow',
    description:
      'Multi-tenant voice-agent platform: outbound call campaigns, realtime AI conversations over Twilio media streams, RAG over uploaded documents, and post-call summaries.',
    stack: 'TypeScript · Express · Next.js · PostgreSQL + pgvector · OpenAI Realtime',
  },
  {
    name: 'TimeLens',
    href: 'https://github.com/whybepb/TimeLens',
    description:
      'Focus and wellness app combining a Pomodoro timer, health metrics, and daily-goal tracking.',
    stack: 'React Native · Expo · TypeScript',
  },
];
---

<Layout title="Prathmesh Bhardwaj — Backend Engineer">
  <div class="space-y-16">
    <header>
      <div
        class="relative mb-8 flex size-16 items-center justify-center rounded-md border-[1.5px] border-[var(--minium)]"
        aria-label="Lead, element 82"
      >
        <span class="absolute left-1.5 top-1 font-mono text-[9px] leading-none">82</span>
        <span class="font-sans text-[2rem] font-semibold leading-none tracking-[-0.03em]">Pb</span>
        <span class="absolute bottom-1 font-mono text-[8px] leading-none text-[var(--muted)]">lead</span>
      </div>

      <h1 class="text-[2rem] font-semibold leading-tight tracking-[-0.02em]">
        Prathmesh Bhardwaj
      </h1>
      <p class="mt-5 max-w-[39rem] text-[1.05rem] leading-8 text-[var(--muted)]">
        Backend engineer from Bangalore, India. I build APIs, realtime systems, and the occasional mobile app — and I like software that stays simple.
      </p>
      <nav class="mt-7 flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs" aria-label="Contact links">
        <a href="https://github.com/whybepb">GitHub</a>
        <a href="mailto:whybepb@gmail.com">Email</a>
        <a href="/resume.pdf" target="_blank" rel="noreferrer">Resume</a>
      </nav>
    </header>

    <section aria-labelledby="work-heading">
      <h2
        id="work-heading"
        class="mb-5 font-mono text-[11px] font-medium tracking-[0.08em] text-[var(--muted)]"
      >
        WORK
      </h2>
      <p class="leading-7">
        I'm a software engineer at Rocketium, the AI creative-automation platform that enterprise marketing teams use to produce campaign-ready images and videos at scale. I work on the backend — building and maintaining the services and APIs behind the platform, and keeping them fast, reliable, and secure.
      </p>
    </section>

    <section aria-labelledby="projects-heading">
      <h2
        id="projects-heading"
        class="mb-5 font-mono text-[11px] font-medium tracking-[0.08em] text-[var(--muted)]"
      >
        PROJECTS
      </h2>

      <div>
        {
          projects.map((project, index) => (
            <article class:list={['py-6', index === 0 ? 'pt-0' : 'border-t border-[var(--hairline)]']}>
              <h3 class="font-mono text-sm font-medium">
                <a href={project.href}>{project.name}</a>
              </h3>
              <p class="mt-3 leading-7">{project.description}</p>
              <p class="mt-3 font-mono text-[11px] leading-5 text-[var(--muted)]">
                {project.stack}
              </p>
            </article>
          ))
        }
      </div>

      <a class="mt-2 inline-block font-mono text-xs" href="https://github.com/whybepb">
        More on GitHub →
      </a>
    </section>

    <footer class="border-t border-[var(--hairline)] pt-8">
      <p class="text-sm text-[var(--muted)]">
        whybepb — Pb is my initials, and element 82: lead. That's the whole story.
      </p>
      <div class="mt-5 flex flex-col gap-3 font-mono text-xs sm:flex-row sm:items-center sm:justify-between">
        <p>© 2026 Prathmesh Bhardwaj</p>
        <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Footer links">
          <a href="https://github.com/whybepb">GitHub</a>
          <a href="mailto:whybepb@gmail.com">Email</a>
          <a href="/resume.pdf" target="_blank" rel="noreferrer">Resume</a>
        </nav>
      </div>
    </footer>
  </div>
</Layout>
